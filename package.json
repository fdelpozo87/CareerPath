{
  "name": "careerpath-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "access:code": "node scripts/gen-access-code.mjs",
    "i18n": "node scripts/gen-i18n.mjs",
    "i18n:check": "node scripts/gen-i18n.mjs --check",
    "eval": "node scripts/eval-coach.mjs",
    "legal:check": "node scripts/legal-check.mjs",
    "brand": "node scripts/gen-brand-assets.mjs",
    "backup": "node scripts/backup.mjs",
    "e2e": "SUPABASE_URL=https://e2e.supabase.test SUPABASE_ANON_KEY=e2e-anon-key vite build --outDir dist-e2e && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/react": "^11.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
